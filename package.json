{
  "name": "breakwater",
  "version": "0.0.1",
  "description": "Aqua liquidity that stops buying the depeg",
  "author": "Breakwater contributors",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "precompile": "mkdir -p node_modules/forge-std && rsync -a node_modules/forge-std/src/ node_modules/forge-std/",
    "build": "npm run precompile && hardhat compile",
    "test": "npm run precompile && hardhat test",
    "test:fork": "npm run precompile && hardhat test test/BreakwaterMainnetFork.test.ts",
    "deploy": "hardhat deploy --network",
    "deploy:localhost": "hardhat deploy --network localhost",
    "clean": "rimraf artifacts cache coverage contracts/hardhat-dependency-compiler deployments typechain-types"
  },
  "dependencies": {
    "@1inch/aqua": "https://github.com/1inch/aqua#81c26e4619ce21556ab02b3284ee2685de21fb18",
    "@1inch/solidity-utils": "6.9.7",
    "@1inch/swap-vm": "https://github.com/1inch/swap-vm#32c687c2b73101fc26549e48fa1ff8a4d73afbac",
    "@openzeppelin/contracts": "5.4.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.9",
    "@nomicfoundation/hardhat-toolbox": "^3.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.14",
    "@1inch/swap-vm-sdk": "0.4.1",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.5",
    "@types/mocha": "^10.0.1",
    "@types/node": "^24.7.2",
    "chai": "^4.3.8",
    "dotenv": "^16.4.5",
    "ethers": "^6.15.0",
    "hardhat": "^2.22.15",
    "hardhat-dependency-compiler": "^1.2.1",
    "hardhat-deploy": "^1.0.4",
    "hardhat-tracer": "^3.4.0",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.9.3",
    "viem": "2.56.3"
  },
  "resolutions":{
    "elliptic": "6.6.1",
    "@1inch/aqua": "https://github.com/1inch/aqua#81c26e4619ce21556ab02b3284ee2685de21fb18",
    "@1inch/solidity-utils": "6.9.7",
    "@openzeppelin/contracts": "5.4.0"
  }
}
